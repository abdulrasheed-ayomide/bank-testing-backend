NODE_ENV=development
PORT=5000
API_VERSION=v1

CLIENT_URL=http://localhost:5173

MONGO_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ADMIN_EXPIRES=4h

OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=30

BCRYPT_SALT_ROUNDS=12

RESEND_API_KEY=
EMAIL_FROM=Spring Financial Bank <onboarding@resend.dev>

# Admin credentials — the password is stored as a bcrypt hash, not plain text.
# Generate one with: npm run seed:admin-hash
ADMIN_EMAIL=admin@sfb.com
ADMIN_PASSWORD_HASH=
